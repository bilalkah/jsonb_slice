CREATE EXTENSION jsonb_slice;
COPY (
    SELECT extname || ':' || extversion || ':' || extrelocatable
    FROM pg_extension
    WHERE extname = 'jsonb_slice'
) TO STDOUT;
jsonb_slice:0.5.0:true
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_get(jsonb,text)'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_get(jsonb,integer)'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_get_text(jsonb,text)'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_get_text(jsonb,integer)'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_path(jsonb,text[])'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_path_text(jsonb,text[])'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT count(*)
    FROM pg_depend AS dependency
    JOIN pg_extension AS extension
      ON extension.oid = dependency.refobjid
    WHERE dependency.refclassid = 'pg_extension'::regclass
      AND dependency.classid = 'pg_proc'::regclass
      AND dependency.deptype = 'e'
      AND extension.extname = 'jsonb_slice'
) TO STDOUT;
6
COPY (
    SELECT count(*)
    FROM pg_depend AS dependency
    JOIN pg_extension AS extension
      ON extension.oid = dependency.refobjid
    WHERE dependency.refclassid = 'pg_extension'::regclass
      AND dependency.classid = 'pg_operator'::regclass
      AND dependency.deptype = 'e'
      AND extension.extname = 'jsonb_slice'
) TO STDOUT;
6
DROP EXTENSION jsonb_slice;
COPY (
    SELECT to_regprocedure('jsonb_slice_get(jsonb,text)') IS NULL AND
           to_regoperator('~>(jsonb,text)') IS NULL AND
           to_regoperator('~>(jsonb,integer)') IS NULL AND
           to_regoperator('~>>(jsonb,text)') IS NULL AND
           to_regoperator('~>>(jsonb,integer)') IS NULL AND
           to_regoperator('~#>(jsonb,text[])') IS NULL AND
           to_regoperator('~#>>(jsonb,text[])') IS NULL
) TO STDOUT;
t
