CREATE EXTENSION jsonb_slice;
CREATE FUNCTION jsonb_slice_test_fetched_bytes()
RETURNS bigint
AS '$libdir/jsonb_slice', 'jsonb_slice_test_fetched_bytes'
LANGUAGE C;
COPY (
    SELECT extname || ':' || extversion || ':' || extrelocatable
    FROM pg_extension
    WHERE extname = 'jsonb_slice'
) TO STDOUT;
jsonb_slice:0.2.0:true
COPY (
    SELECT p.provolatile::text || ':' || p.proisstrict::text || ':' ||
           p.proparallel::text
    FROM pg_proc AS p
    WHERE p.oid = 'jsonb_slice_get(jsonb,text)'::regprocedure
) TO STDOUT;
i:true:s
COPY (
    SELECT count(*)
    FROM pg_depend AS dependency
    JOIN pg_extension AS extension
      ON extension.oid = dependency.refobjid
    WHERE dependency.refclassid = 'pg_extension'::regclass
      AND dependency.classid = 'pg_proc'::regclass
      AND dependency.deptype = 'e'
      AND extension.extname = 'jsonb_slice'
) TO STDOUT;
1
COPY (
    SELECT test_name || ':' ||
           (jsonb_slice_get(document, field_name) IS NOT DISTINCT FROM
            document -> field_name)
    FROM (VALUES
        ('string',       '{"field": "value"}'::jsonb,   'field'),
        ('number',       '{"field": 42}'::jsonb,        'field'),
        ('boolean',      '{"field": true}'::jsonb,      'field'),
        ('json null',    '{"field": null}'::jsonb,      'field'),
        ('object',       '{"field": {"n": 1}}'::jsonb, 'field'),
        ('array',        '{"field": [1, 2]}'::jsonb,    'field'),
        ('empty key',    '{"": "value"}'::jsonb,      ''),
        ('missing key',  '{"field": 1}'::jsonb,         'missing'),
        ('multibyte key', '{"ключ": "значение"}'::jsonb, 'ключ'),
        ('array input',  '[1, 2]'::jsonb,                 'field'),
        ('scalar input', '1'::jsonb,                      'field')
    ) AS cases(test_name, document, field_name)
    ORDER BY test_name
) TO STDOUT;
array:true
array input:true
boolean:true
empty key:true
json null:true
missing key:true
multibyte key:true
number:true
object:true
scalar input:true
string:true
COPY (
    SELECT jsonb_slice_get(NULL::jsonb, 'field') IS NULL AND
           jsonb_slice_get('{"field": 1}'::jsonb, NULL::text) IS NULL
) TO STDOUT;
t
CREATE TABLE toasted_input (document jsonb);
ALTER TABLE toasted_input ALTER COLUMN document SET STORAGE EXTERNAL;
INSERT INTO toasted_input
SELECT jsonb_build_object(
	'', 'empty key',
	'array', jsonb_build_array(1, 2),
	'boolean', true,
	'json null', NULL,
	'multibyte', 'çğıöşü 日本語',
	'number', 42,
	'object', jsonb_build_object('value', 1),
	'string', 'value',
	'ключ', 'значение',
	'padding a', repeat('x', 12000),
	'padding b', repeat('y', 12000)
);
COPY (
	SELECT test_name || ':' ||
		   (jsonb_slice_get(document, field_name) IS NOT DISTINCT FROM
			document -> field_name)
	FROM toasted_input
	CROSS JOIN (VALUES
		('array', 'array'),
		('boolean', 'boolean'),
		('empty key', ''),
		('json null', 'json null'),
		('missing key', 'missing'),
		('multibyte key', 'ключ'),
		('multibyte value', 'multibyte'),
		('number', 'number'),
		('object', 'object'),
		('string', 'string')
	) AS cases(test_name, field_name)
	ORDER BY test_name
) TO STDOUT;
array:true
boolean:true
empty key:true
json null:true
missing key:true
multibyte key:true
multibyte value:true
number:true
object:true
string:true
COPY (
	SELECT jsonb_slice_test_fetched_bytes() > 0 AND
		   jsonb_slice_test_fetched_bytes() <
		   (SELECT pg_column_size(document) FROM toasted_input)
) TO STDOUT;
t
DROP TABLE toasted_input;
COPY (
	SELECT jsonb_slice_get('{"field": 1}'::jsonb, 'field') = '1'::jsonb
) TO STDOUT;
t
COPY (
	SELECT jsonb_slice_test_fetched_bytes() IS NULL
) TO STDOUT;
t
CREATE TABLE compressed_input (document jsonb);
INSERT INTO compressed_input
SELECT jsonb_build_object('field', 'value', 'padding', repeat('z', 24000));
COPY (
	SELECT pg_column_size(document) < 2000 AND
		   jsonb_slice_get(document, 'field') = document -> 'field'
	FROM compressed_input
) TO STDOUT;
t
COPY (
	SELECT jsonb_slice_test_fetched_bytes() IS NULL
) TO STDOUT;
t
DROP TABLE compressed_input;
DROP FUNCTION jsonb_slice_test_fetched_bytes();
DROP EXTENSION jsonb_slice;
COPY (
    SELECT to_regprocedure('jsonb_slice_get(jsonb,text)') IS NULL
) TO STDOUT;
t
CREATE EXTENSION jsonb_slice VERSION '0.1.0';
COPY (
    SELECT extversion || ':' ||
           (to_regprocedure('jsonb_slice_get(jsonb,text)') IS NULL)
    FROM pg_extension
    WHERE extname = 'jsonb_slice'
) TO STDOUT;
0.1.0:true
ALTER EXTENSION jsonb_slice UPDATE TO '0.2.0';
COPY (
    SELECT extversion || ':' ||
           (jsonb_slice_get('{"field": "value"}'::jsonb, 'field') = '"value"'::jsonb)
    FROM pg_extension
    WHERE extname = 'jsonb_slice'
) TO STDOUT;
0.2.0:true
DROP EXTENSION jsonb_slice;
